{
  "name": "stripe-projects-visualizer",
  "version": "0.1.0",
  "description": "Visualize the architecture and data flow of Stripe Projects",
  "type": "module",
  "bin": {
    "stripe-projects-viz": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
